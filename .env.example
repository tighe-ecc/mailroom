# Copy to .env and fill in your keys. .env is gitignored.

# EasyPost — carrier tracking. Sign up at https://www.easypost.com/signup
# Test keys start with "EZTK", production with "EZAK".
EASYPOST_API_KEY=

# OpenAI — email parsing via gpt-4o-mini. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: path override for the SQLite file. Defaults to ~/mailroom/db.sqlite.
# MAILROOM_DB=

# Optional: path override for the inbox directory. Defaults to ~/mailroom/inbox.
# MAILROOM_INBOX=

# Optional: URL opened when a desktop notification is clicked. Defaults to http://localhost:47821.
# MAILROOM_URL=
