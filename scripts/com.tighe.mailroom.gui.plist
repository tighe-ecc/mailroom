<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tighe.mailroom.gui</string>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/mailroom/.venv/bin/uvicorn</string>
        <string>app:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>47821</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/mailroom</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Include /opt/homebrew/bin so notify.py can find terminal-notifier
             on Apple Silicon. Without it, notifications fall back to osascript
             and clicking them opens Script Editor instead of the dashboard. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/tmp/mailroom-gui.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/mailroom-gui.log</string>
</dict>
</plist>
